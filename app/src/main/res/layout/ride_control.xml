<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/field_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp" android:background="#090B0F">
<TextView android:id="@+id/field_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/control_unknown" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp"/>
<TextView android:id="@+id/field_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center"/>
<LinearLayout android:id="@+id/field_buttons" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
<include layout="@layout/control_buttons"/>
</LinearLayout>
<LinearLayout android:id="@+id/field_compact" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/field_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:gravity="center" android:text="@string/control_play" android:textColor="#FFFFFF" android:background="@drawable/control_tile" android:textSize="15sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:singleLine="true"/>
<TextView android:id="@+id/field_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:gravity="center" android:text="@string/control_pause" android:textColor="#FFFFFF" android:background="@drawable/control_tile" android:textSize="15sp"/>
<TextView android:id="@+id/field_wake" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:gravity="center" android:text="@string/control_stop" android:textColor="#FFFFFF" android:background="@drawable/control_tile" android:textSize="15sp"/>
</LinearLayout>
</LinearLayout>
