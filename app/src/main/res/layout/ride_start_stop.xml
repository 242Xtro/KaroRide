<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toggle_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="4dp" android:background="#090B0F" android:clickable="true">
    <TextView android:id="@+id/toggle_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF"
        android:textSize="12sp" android:text="@string/control_unknown" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/toggle_icon" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"
            android:src="@drawable/ic_play" android:importantForAccessibility="no" />
        <TextView android:id="@+id/toggle_action" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:maxLines="1"
            android:ellipsize="end" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp"
            android:text="@string/control_play" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" />
    </LinearLayout>
</LinearLayout>
