<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp" android:background="#090B0F">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageButton android:id="@+id/screen_back" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/ic_back" android:contentDescription="@string/control_back" android:background="@drawable/control_tile"/>
<TextView android:id="@+id/screen_camera" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/control_camera_select" android:textSize="17sp" android:singleLine="true" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/control_tile" android:layout_marginHorizontal="4dp" android:paddingHorizontal="3dp" android:contentDescription="@string/control_camera_select"/>
<ImageButton android:id="@+id/screen_settings" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/ic_settings" android:contentDescription="@string/control_settings" android:background="@drawable/control_tile"/>
</LinearLayout>
<LinearLayout android:id="@+id/screen_status" android:layout_width="match_parent" android:layout_height="84dp" android:layout_marginTop="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/status_panel" android:padding="2dp">
<TextView android:id="@+id/screen_state" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:singleLine="true" android:text="@string/control_unknown" android:textSize="22sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/screen_connection" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:singleLine="true" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:text="@string/control_disconnected" android:textSize="14sp" android:textColor="#D5DFEC"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal">
<TextView android:id="@+id/screen_battery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/control_battery_unknown" android:textSize="14sp" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/screen_storage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/control_storage_unknown" android:textSize="14sp" android:textColor="#FFFFFF"/>
</LinearLayout>
<TextView android:id="@+id/screen_time" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:singleLine="true" android:text="@string/control_time_unknown" android:textSize="16sp" android:textColor="#FFFFFF"/>
</LinearLayout>
<include layout="@layout/control_buttons" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp"/>
<TextView android:id="@+id/screen_message" android:layout_width="match_parent" android:layout_height="28dp" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:padding="0dp" android:text="@string/control_select_first" android:textSize="12sp" android:textColor="#CCD5E1"/>
</LinearLayout>
